# App settings
APP_NAME=Aegis
APP_VERSION=1.0.0
DEBUG=true

# Supabase settings
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# OpenAI settings
